<views:ScreenView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SailRacing.Desktop.Views"
             x:Class="SailRacing.Desktop.Views.SettingsView">

	<ScrollViewer>
		<StackPanel Margin="12" Spacing="20" MaxWidth="760" HorizontalAlignment="Left">

			<TextBlock Text="Server" Classes="bold" />
			<TextBox Watermark="https://your-server" Text="{Binding ServerBaseUrlText}" />

			<TextBlock Text="Start sequence" Classes="bold" />
			<Grid ColumnDefinitions="260,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
				<TextBlock Grid.Row="0" Text="Alarm (minutes before start)" VerticalAlignment="Center" />
				<TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SequenceAlarmsText}" Watermark="-10,-6"
				         ToolTip.Tip="Get-ready alarms, in minutes before the start, separated by commas. Leave empty for none." />
				<TextBlock Grid.Row="1" Text="Countdown (seconds)" VerticalAlignment="Center" />
				<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SequenceCountdownText}" Watermark="10"
				         ToolTip.Tip="How many seconds are counted down out loud before each signal (0 to 30; 0 turns it off)." />
				<TextBlock Grid.Row="2" Text="Signals (class, P up, P down, start)" VerticalAlignment="Center" />
				<TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SequenceSignalsText}" Watermark="-5,-4,-1,0"
				         ToolTip.Tip="Class flag up, P flag up, P flag down, start — minutes before the start. The last one is the start, so it is 0." />
			</Grid>
			<TextBlock Text="{Binding SequencePreview}" Classes="dim" TextWrapping="Wrap" />
			<TextBlock Text="{Binding SequenceError}" Classes="warn" IsVisible="{Binding HasSequenceError}" TextWrapping="Wrap" />
			<Button Content="Reset to the standard 5-4-1-0 sequence" HorizontalAlignment="Left" Command="{Binding ResetSequenceCommand}" />
			<TextBlock Classes="dim" TextWrapping="Wrap"
			           Text="Applies to the next start sequence you begin. Times are minutes before the start (with or without the minus sign); the sequence begins at the earliest of the alarms and the first signal." />

			<TextBlock Text="Audio output (announcements speaker)" Classes="bold" />
			<ComboBox ItemsSource="{Binding AudioOutputDevices}" SelectedItem="{Binding SelectedAudioOutputDevice}" HorizontalAlignment="Stretch">
				<ComboBox.ItemTemplate>
					<DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>

			<TextBlock Text="Audio input (microphone)" Classes="bold" />
			<ComboBox ItemsSource="{Binding AudioInputDevices}" SelectedItem="{Binding SelectedAudioInputDevice}" HorizontalAlignment="Stretch">
				<ComboBox.ItemTemplate>
					<DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>

			<TextBlock Text="Video input (camera)" Classes="bold" />
			<ComboBox ItemsSource="{Binding VideoInputDevices}" SelectedItem="{Binding SelectedVideoInputDevice}" HorizontalAlignment="Stretch">
				<ComboBox.ItemTemplate>
					<DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>

			<CheckBox IsChecked="{Binding AutoFinishPhoto}" Content="Take a photo with this camera when a boat finishes"
			          ToolTip.Tip="The Timing Sheet photographs each boat as it finishes — stamped with the time (24 h) and the GPS position — and saves it under Documents/Sail-Racing photos. You can also take a photo of any boat by hand on the Timing Sheet." />
			<TextBlock Classes="dim" TextWrapping="Wrap"
			           Text="Photos are saved on this PC and are not sent to the server. On Linux the camera is read with ffmpeg (or fswebcam): sudo apt install ffmpeg." />

			<CheckBox IsChecked="{Binding RecordStartVideo}" Content="Record a video of each start, from one minute before the start until All Clear"
			          ToolTip.Tip="The start video begins one minute before the start and runs until you press All Clear. It is recorded with the camera and microphone chosen in Settings and saved under Documents/Sail-Racing videos. You can also start or stop it by hand on the Start Sequence screen." />
			<CheckBox IsChecked="{Binding RecordStartVideoSound}" Content="Include the sound from the microphone chosen above" Margin="28,0,0,0"
			          IsVisible="{Binding RecordStartVideo}" />
			<TextBlock Classes="dim" TextWrapping="Wrap"
			           Text="Videos are saved on this PC, not sent to the server. The camera and microphone are on while recording, and the start announcements will be on the sound. The video is recorded with ffmpeg (sudo apt install ffmpeg), which also draws the 24-hour time and GPS position on the picture; a .srt subtitle file beside the video has them for every second." />

			<TextBlock Classes="dim" TextWrapping="Wrap"
			           Text="On Linux the audio devices come from PulseAudio/PipeWire (pactl) and the cameras from /dev/video*. The audio devices are saved as preferences for a future feature; the camera is used for the finish photos above. Spoken announcements need espeak-ng installed (sudo apt install espeak-ng); GPS capture is not available on this app — type coordinates in, or capture them with the Windows app." />

			<TextBlock Text="{Binding StatusMessage}" Foreground="Gray" TextWrapping="Wrap" />

			<StackPanel Classes="row">
				<Button Content="Refresh devices" Command="{Binding LoadCommand}" />
				<Button Content="Save" Command="{Binding SaveCommand}" />
			</StackPanel>

		</StackPanel>
	</ScrollViewer>
</views:ScreenView>
