<views:ScreenView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SailRacing.Desktop.Views"
             xmlns:flags="clr-namespace:SailRacing.Desktop.Views.Controls"
             x:Class="SailRacing.Desktop.Views.StartSequenceView">

	<ScrollViewer>
		<StackPanel Margin="24" Spacing="12" HorizontalAlignment="Center" MaxWidth="760">

			<StackPanel Classes="row" HorizontalAlignment="Left">
				<Button Content="‹ Races" Command="{Binding BackToRacesCommand}"
				        ToolTip.Tip="Back to the race list (the sequence keeps running)" />
				<Button Content="Edit race" Command="{Binding EditRaceCommand}" />
			</StackPanel>

			<!-- Pre-sequence feedback: shown before "Begin Start Sequence" is pressed -->
			<StackPanel Spacing="6" HorizontalAlignment="Center" IsVisible="{Binding !IsSequenceStarted}">
				<TextBlock Text="{Binding CurrentTimeText}" FontSize="40" HorizontalAlignment="Center" />
				<TextBlock Text="{Binding ScheduledCountdownText}" FontSize="16" Foreground="Gray" HorizontalAlignment="Center"
				           IsVisible="{Binding HasScheduledStartTime}" />
				<TextBlock Text="No scheduled start time — click Begin when ready" FontSize="14" Foreground="Gray" HorizontalAlignment="Center"
				           IsVisible="{Binding !HasScheduledStartTime}" />
			</StackPanel>

			<!-- Flag stage: three rows. A flag that is up is shown in the top row, just above the counter; a flag
			     that is down rests in the bottom row. The two rows share their columns, so a hoisted flag appears
			     straight above where it was resting. -->
			<Grid RowDefinitions="100,100,100" HorizontalAlignment="Center" Width="320">

				<Grid Grid.Row="0" ColumnDefinitions="110,100" ColumnSpacing="20" HorizontalAlignment="Center" VerticalAlignment="Bottom">
					<flags:ClassFlag x:Name="ClassFlagUp" Grid.Column="0" VerticalAlignment="Bottom" IsVisible="{Binding ClassFlagUp}" />
					<flags:PFlag x:Name="PFlagUp" Grid.Column="1" VerticalAlignment="Bottom" IsVisible="{Binding PFlagUp}" />
				</Grid>

				<TextBlock Grid.Row="1" Text="{Binding CountdownText}" FontSize="64" HorizontalAlignment="Center"
				           VerticalAlignment="Center" IsVisible="{Binding IsSequenceStarted}" />

				<Grid Grid.Row="2" ColumnDefinitions="110,100" ColumnSpacing="20" HorizontalAlignment="Center" VerticalAlignment="Top">
					<flags:ClassFlag x:Name="ClassFlagDown" Grid.Column="0" VerticalAlignment="Top" IsVisible="{Binding !ClassFlagUp}" />
					<flags:PFlag x:Name="PFlagDown" Grid.Column="1" VerticalAlignment="Top" IsVisible="{Binding !PFlagUp}" />
				</Grid>
			</Grid>

			<TextBlock Text="{Binding StartAtText}" FontSize="18" HorizontalAlignment="Center" Foreground="Gray"
			           IsVisible="{Binding IsSequenceStarted}" />

			<Button Content="Begin Start Sequence" Command="{Binding BeginSequenceCommand}" HorizontalAlignment="Center"
			        IsVisible="{Binding !IsSequenceStarted}" />

			<TextBlock Text="Sequence complete — awaiting All Clear" IsVisible="{Binding IsSequenceComplete}" HorizontalAlignment="Center" />

			<Button Content="All Clear — Start Race Mode" Classes="go" Command="{Binding AllClearCommand}"
			        HorizontalAlignment="Center" IsVisible="{Binding IsSequenceComplete}" />

			<Button Content="Cancel sequence &amp; reset" Classes="danger" Command="{Binding CancelSequenceCommand}"
			        IsVisible="{Binding CanCancelSequence}" HorizontalAlignment="Center"
			        ToolTip.Tip="Abandon this start sequence (postponement or recall): the countdown stops, the flags come down and you can begin again" />

			<!-- Competitor links stay available here once the race is launched. -->
			<StackPanel Spacing="6" Margin="0,16,0,0">
				<TextBlock Text="Competitor links" Classes="bold" />
				<StackPanel Orientation="Horizontal" Spacing="6">
					<TextBlock Text="{Binding MapLinkText}" Classes="dim" VerticalAlignment="Center"
					           TextTrimming="CharacterEllipsis" MaxWidth="520" />
					<Button Content="Open live map" Classes="small" IsVisible="{Binding HasMapUrl}" Command="{Binding OpenMapCommand}" />
					<Button Content="Copy link" Classes="small" IsVisible="{Binding HasMapUrl}" Command="{Binding CopyMapLinkCommand}" />
				</StackPanel>

				<ItemsControl ItemsSource="{Binding BoatLinks}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<StackPanel Spacing="1" Margin="0,0,0,4">
								<TextBlock Text="{Binding ParticipantName}" FontSize="13" Classes="bold" />
								<StackPanel Orientation="Horizontal" Spacing="6">
									<TextBlock Text="{Binding JoinLinkText}" Classes="dim" VerticalAlignment="Center"
									           TextTrimming="CharacterEllipsis" MaxWidth="480" />
									<Button Content="Copy link" Classes="small" IsVisible="{Binding HasJoinUrl}"
									        Command="{Binding $parent[ScrollViewer].DataContext.CopyBoatLinkCommand}" CommandParameter="{Binding}" />
								</StackPanel>
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<TextBlock Text="{Binding LinkMessage}" Classes="dim" />
			</StackPanel>

		</StackPanel>
	</ScrollViewer>
</views:ScreenView>
