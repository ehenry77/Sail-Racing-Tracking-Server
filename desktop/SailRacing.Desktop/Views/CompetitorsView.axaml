<views:ScreenView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SailRacing.Desktop.Views"
             x:Class="SailRacing.Desktop.Views.CompetitorsView">

	<Grid RowDefinitions="Auto,*" Margin="12" RowSpacing="12">

		<Border Grid.Row="0" Classes="card" IsVisible="{Binding IsEditing}">
			<StackPanel Spacing="8">
				<TextBox Watermark="Name" Text="{Binding EditName}" />
				<TextBox Watermark="Helm" Text="{Binding EditHelm}" />
				<TextBox Watermark="TCF" Text="{Binding EditTcf}"
				         ToolTip.Tip="Time Correction Factor — handicap rating used to compute corrected time (corrected time = elapsed time × TCF)" />
				<StackPanel Classes="row">
					<Button Content="Save" Command="{Binding SaveCommand}" />
					<Button Content="Cancel" Command="{Binding CancelEditCommand}" />
				</StackPanel>
			</StackPanel>
		</Border>

		<ScrollViewer Grid.Row="1">
			<ItemsControl ItemsSource="{Binding Participants}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Grid Margin="0,0,0,6" Background="Transparent" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
							<StackPanel Grid.Column="0">
								<TextBlock Text="{Binding Name}" Classes="bold" />
								<TextBlock Text="{Binding Helm, StringFormat='Helm: {0}'}" FontSize="12" />
								<TextBlock Text="{Binding Tcf, StringFormat='TCF: {0}'}" FontSize="12"
								           ToolTip.Tip="Time Correction Factor — handicap rating used to compute corrected time" />
							</StackPanel>
							<Button Grid.Column="1" Content="Edit"
							        Command="{Binding $parent[ItemsControl].DataContext.EditCommand}" CommandParameter="{Binding}" />
							<Button Grid.Column="2" Content="Delete"
							        Command="{Binding $parent[ItemsControl].DataContext.DeleteCommand}" CommandParameter="{Binding}" />
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<Button Grid.Row="1" Content="+" FontSize="24" Width="56" Height="56" CornerRadius="28"
		        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
		        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12"
		        Command="{Binding AddNewCommand}" />
	</Grid>
</views:ScreenView>
