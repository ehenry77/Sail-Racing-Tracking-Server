{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResultPublication",
  "type": "object",
  "required": ["raceId", "publishedAt", "results"],
  "properties": {
    "raceId": { "type": "string", "format": "uuid" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["participantId", "status"],
        "properties": {
          "participantId": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["Finished", "DNF", "DNS", "RET", "OCS"] },
          "elapsedSeconds": { "type": ["number", "null"] },
          "correctedSeconds": { "type": ["number", "null"] },
          "rank": { "type": ["integer", "null"] }
        }
      }
    }
  }
}
