{
  "name": "sail-racing-server",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js server for Sail-Racing: race replication, competitor GPS tracking, live map, lap-counting.",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postinstall": "npm run build",
    "start": "npm run build && node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts"
  },
  "dependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/ws": "^8.5.12",
    "express": "^4.21.0",
    "typescript": "^5.6.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0"
  }
}
