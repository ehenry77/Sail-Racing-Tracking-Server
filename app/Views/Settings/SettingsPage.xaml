<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SailRacing.ViewModels;assembly=SailRacing.Core"
             xmlns:devices="clr-namespace:SailRacing.Services.Devices;assembly=SailRacing.Core"
             x:Class="SailRacing.Views.Settings.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="20">

            <Label Text="Server" FontAttributes="Bold" />
            <Entry Placeholder="https://your-server" Text="{Binding ServerBaseUrlText}" />

            <Label Text="Start sequence" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="8">
                <Label Text="Alarm (minutes before start)" VerticalOptions="Center" WidthRequest="250" />
                <Entry Text="{Binding SequenceAlarmsText}" Placeholder="-10,-6" WidthRequest="200"
                       ToolTipProperties.Text="Get-ready alarms, in minutes before the start, separated by commas. Leave empty for none." />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="8">
                <Label Text="Countdown (seconds)" VerticalOptions="Center" WidthRequest="250" />
                <Entry Text="{Binding SequenceCountdownText}" Placeholder="10" Keyboard="Numeric" WidthRequest="200"
                       ToolTipProperties.Text="How many seconds are counted down out loud before each signal (0 to 30; 0 turns it off)." />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="8">
                <Label Text="Signals (class, P up, P down, start)" VerticalOptions="Center" WidthRequest="250" />
                <Entry Text="{Binding SequenceSignalsText}" Placeholder="-5,-4,-1,0" WidthRequest="200"
                       ToolTipProperties.Text="Class flag up, P flag up, P flag down, start — minutes before the start. The last one is the start, so it is 0." />
            </HorizontalStackLayout>
            <Label Text="{Binding SequencePreview}" FontSize="12" TextColor="Gray" />
            <Label Text="{Binding SequenceError}" FontSize="12" TextColor="OrangeRed" IsVisible="{Binding HasSequenceError}" />
            <Button Text="Reset to the standard 5-4-1-0 sequence" HorizontalOptions="Start" Command="{Binding ResetSequenceCommand}" />
            <Label Text="Applies to the next start sequence you begin. Times are minutes before the start (with or without the minus sign); the sequence begins at the earliest of the alarms and the first signal."
                   FontSize="12" TextColor="Gray" />

            <Label Text="Audio output (announcements speaker)" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding AudioOutputDevices}" SelectedItem="{Binding SelectedAudioOutputDevice}">
                <Picker.ItemDisplayBinding>
                    <Binding Path="Name" x:DataType="devices:MediaDeviceInfo" />
                </Picker.ItemDisplayBinding>
            </Picker>

            <Label Text="Audio input (microphone)" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding AudioInputDevices}" SelectedItem="{Binding SelectedAudioInputDevice}">
                <Picker.ItemDisplayBinding>
                    <Binding Path="Name" x:DataType="devices:MediaDeviceInfo" />
                </Picker.ItemDisplayBinding>
            </Picker>

            <Label Text="Video input (camera)" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding VideoInputDevices}" SelectedItem="{Binding SelectedVideoInputDevice}">
                <Picker.ItemDisplayBinding>
                    <Binding Path="Name" x:DataType="devices:MediaDeviceInfo" />
                </Picker.ItemDisplayBinding>
            </Picker>

            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding AutoFinishPhoto}" />
                <Label Text="Take a photo with this camera when a boat finishes" VerticalOptions="Center"
                       ToolTipProperties.Text="The Timing Sheet photographs each boat as it finishes — stamped with the time (24 h) and the GPS position — and saves it under Documents\Sail-Racing photos. You can also take a photo of any boat by hand on the Timing Sheet." />
            </HorizontalStackLayout>
            <Label Text="With this on, the camera is switched on while the Timing Sheet is open, so its light will be lit. Photos are saved on this PC and are not sent to the server."
                   FontSize="12" TextColor="Gray" />

            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding RecordStartVideo}" />
                <Label Text="Record a video of each start, from one minute before the start until All Clear" VerticalOptions="Center"
                       ToolTipProperties.Text="The start video begins one minute before the start and runs until you press All Clear. It is recorded with the camera and microphone chosen in Settings and saved under Documents/Sail-Racing videos. You can also start or stop it by hand on the Start Sequence screen." />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="8" Margin="32,0,0,0" IsVisible="{Binding RecordStartVideo}">
                <CheckBox IsChecked="{Binding RecordStartVideoSound}" />
                <Label Text="Include the sound from the microphone chosen above" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label Text="Videos are saved on this PC, not sent to the server. The camera and microphone are on while recording, and the start announcements will be on the sound. The 24-hour time and GPS position are drawn on the picture when ffmpeg is installed (in a terminal: winget install Gyan.FFmpeg, then restart the app); without it the video is recorded without them on the picture. Either way a .srt subtitle file beside the video has them for every second."
                   FontSize="12" TextColor="Gray" />

            <Label Text="GPS sensor (Windows only)" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding GpsSensors}" SelectedItem="{Binding SelectedGpsSensor}">
                <Picker.ItemDisplayBinding>
                    <Binding Path="Name" x:DataType="devices:MediaDeviceInfo" />
                </Picker.ItemDisplayBinding>
            </Picker>
            <Label Text="Lists the laptop's built-in location sensor plus any external GPS receiver installed as a Windows location sensor. Only available on Windows — other platforms only ever expose one GPS chip."
                   FontSize="12" TextColor="Gray" />

            <Label Text="The audio devices are saved as preferences for a future feature; the camera is used for the finish photos above."
                   FontSize="12" TextColor="Gray" />

            <Label Text="{Binding StatusMessage}" TextColor="Gray" />

            <HorizontalStackLayout Spacing="8">
                <Button Text="Refresh devices" Command="{Binding LoadCommand}" />
                <Button Text="Save" Command="{Binding SaveCommand}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
