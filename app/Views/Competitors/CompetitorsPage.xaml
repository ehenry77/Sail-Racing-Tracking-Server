<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SailRacing.ViewModels"
             xmlns:models="clr-namespace:SailRacing.Models"
             x:Class="SailRacing.Views.Competitors.CompetitorsPage"
             x:DataType="vm:CompetitorsViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*" Padding="12" RowSpacing="12">

        <Border Grid.Row="0" IsVisible="{Binding IsEditing}" Padding="12" Stroke="Gray" StrokeShape="RoundRectangle 8">
            <VerticalStackLayout Spacing="8">
                <Entry Placeholder="Name" Text="{Binding EditName}" />
                <Entry Placeholder="Helm" Text="{Binding EditHelm}" />
                <Entry Placeholder="TCF" Text="{Binding EditTcf}" Keyboard="Numeric" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Save" Command="{Binding SaveCommand}" />
                    <Button Text="Cancel" Command="{Binding CancelEditCommand}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <RefreshView Grid.Row="1" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Participants}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Participant">
                        <Grid Padding="8" ColumnDefinitions="*,Auto,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Text="{Binding Helm, StringFormat='Helm: {0}'}" FontSize="12" />
                                <Label Text="{Binding Tcf, StringFormat='TCF: {0}'}" FontSize="12" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Edit"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CompetitorsViewModel}}, Path=EditCommand}"
                                    CommandParameter="{Binding .}" />
                            <Button Grid.Column="2" Text="Delete"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CompetitorsViewModel}}, Path=DeleteCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="1" Text="+" VerticalOptions="End" HorizontalOptions="End"
                WidthRequest="56" HeightRequest="56" CornerRadius="28"
                Command="{Binding AddNewCommand}" Margin="0,0,12,12" />
    </Grid>
</ContentPage>
