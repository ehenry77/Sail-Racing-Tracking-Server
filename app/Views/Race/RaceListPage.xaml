<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SailRacing.ViewModels;assembly=SailRacing.Core"
             xmlns:models="clr-namespace:SailRacing.Models;assembly=SailRacing.Core"
             x:Class="SailRacing.Views.Race.RaceListPage"
             x:DataType="vm:RaceListViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="*" Padding="12">
        <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Races}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:RaceListItem">
                        <Grid Padding="8" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Text="{Binding Status}" FontSize="12" />
                                <Label Text="{Binding CodeText}" FontSize="12" FontAttributes="Bold"
                                       ToolTipProperties.Text="The race code: competitors, the live map and other committee PCs (Take over a race) use it to find this race" />
                                <Label Text="{Binding ScheduledStartTime, StringFormat='Scheduled: {0:HH:mm}'}"
                                       FontSize="12" TextColor="Gray"
                                       IsVisible="{Binding ScheduledStartTime, Converter={StaticResource NotNullConverter}}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Edit"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RaceListViewModel}}, Path=EditCommand}"
                                    CommandParameter="{Binding Race}" />
                            <Button Grid.Column="2" Text="Open"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RaceListViewModel}}, Path=OpenCommand}"
                                    CommandParameter="{Binding Race}" />
                            <Button Grid.Column="3" Text="Delete" BackgroundColor="#B23A3A" TextColor="White"
                                    ToolTipProperties.Text="Delete this race from this PC (its copy on the server is kept)"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RaceListViewModel}}, Path=DeleteCommand}"
                                    CommandParameter="{Binding Race}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <VerticalStackLayout VerticalOptions="End" HorizontalOptions="End" Spacing="6" Margin="0,0,0,12">
            <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="Gray" HorizontalOptions="End" />
            <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                <Button Text="Take over a race…" Command="{Binding TakeOverCommand}"
                        ToolTipProperties.Text="Continue a race started on another committee PC: pulls it from the server by its join code" />
                <Button Text="+ New Race" Command="{Binding NewRaceCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
