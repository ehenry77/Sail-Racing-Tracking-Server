<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SailRacing.ViewModels;assembly=SailRacing.Core"
             xmlns:flags="clr-namespace:SailRacing.Views.Race.Controls"
             x:Class="SailRacing.Views.Race.StartSequencePage"
             x:DataType="vm:StartSequenceViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">

            <HorizontalStackLayout Spacing="8" HorizontalOptions="Start">
                <Button Text="‹ Races" Command="{Binding BackToRacesCommand}"
                        ToolTipProperties.Text="Back to the race list (the sequence keeps running)" />
                <Button Text="Edit race" Command="{Binding EditRaceCommand}" />
                <Label Text="{Binding RaceHeaderText}" FontAttributes="Bold" VerticalOptions="Center"
                       ToolTipProperties.Text="The race code: competitors, the live map and other committee PCs (Take over a race) use it to find this race" />
                <Button Text="Copy code" FontSize="11" Padding="8,0" HeightRequest="26" VerticalOptions="Center"
                        IsVisible="{Binding HasRaceCode}" Command="{Binding CopyRaceCodeCommand}" />
            </HorizontalStackLayout>

            <!-- Pre-sequence feedback: shown before "Begin Start Sequence" is pressed -->
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center"
                                  IsVisible="{Binding IsSequenceStarted, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="{Binding CurrentTimeText}" FontSize="40" HorizontalOptions="Center" />
                <Label Text="{Binding ScheduledCountdownText}" FontSize="16" TextColor="Gray" HorizontalOptions="Center"
                       IsVisible="{Binding HasScheduledStartTime}" />
                <Label Text="No scheduled start time — tap Begin when ready" FontSize="14" TextColor="Gray"
                       HorizontalOptions="Center"
                       IsVisible="{Binding HasScheduledStartTime, Converter={StaticResource InvertedBoolConverter}}" />
            </VerticalStackLayout>

            <!-- Flag stage: three rows. A flag that is up is shown in the top row, just above the counter;
                 a flag that is down rests in the bottom row. (Sliding the flags between the two with a
                 translation made them vanish on Windows, so each flag is simply shown where it belongs and
                 fades in — see StartSequencePage.xaml.cs.) The two rows share the same columns, so a flag
                 hoisted from the bottom row appears straight above where it was. -->
            <Grid RowDefinitions="100,100,100" HorizontalOptions="Center" WidthRequest="320">

                <Grid Grid.Row="0" ColumnDefinitions="110,100" ColumnSpacing="20" HorizontalOptions="Center" VerticalOptions="End">
                    <flags:ClassFlagView x:Name="ClassFlagUpView" Grid.Column="0" VerticalOptions="End"
                                         IsVisible="{Binding ClassFlagUp}" />
                    <flags:PFlagView x:Name="PFlagUpView" Grid.Column="1" VerticalOptions="End"
                                     IsVisible="{Binding PFlagUp}" />
                </Grid>

                <Label Grid.Row="1" Text="{Binding CountdownText}" FontSize="64" HorizontalOptions="Center"
                       VerticalOptions="Center" IsVisible="{Binding IsSequenceStarted}" />

                <Grid Grid.Row="2" ColumnDefinitions="110,100" ColumnSpacing="20" HorizontalOptions="Center" VerticalOptions="Start">
                    <flags:ClassFlagView x:Name="ClassFlagDownView" Grid.Column="0" VerticalOptions="Start"
                                         IsVisible="{Binding ClassFlagUp, Converter={StaticResource InvertedBoolConverter}}" />
                    <flags:PFlagView x:Name="PFlagDownView" Grid.Column="1" VerticalOptions="Start"
                                     IsVisible="{Binding PFlagUp, Converter={StaticResource InvertedBoolConverter}}" />
                </Grid>
            </Grid>

            <Label Text="{Binding StartAtText}" FontSize="18" HorizontalOptions="Center" TextColor="Gray"
                   IsVisible="{Binding IsSequenceStarted}" />

            <Button Text="Begin Start Sequence" Command="{Binding BeginSequenceCommand}"
                    IsVisible="{Binding IsSequenceStarted, Converter={StaticResource InvertedBoolConverter}}" />

            <Label Text="Sequence complete — awaiting All Clear" IsVisible="{Binding IsSequenceComplete}"
                   HorizontalOptions="Center" />

            <Button Text="All Clear — Start Race Mode" Command="{Binding AllClearCommand}"
                    IsVisible="{Binding IsSequenceComplete}" BackgroundColor="Green" TextColor="White" />

            <Button Text="Cancel sequence &amp; reset" Command="{Binding CancelSequenceCommand}"
                    IsVisible="{Binding CanCancelSequence}" BackgroundColor="#B23A3A" TextColor="White"
                    HorizontalOptions="Center"
                    ToolTipProperties.Text="Abandon this start sequence (postponement or recall): the countdown stops, the flags come down and you can begin again" />

            <!-- Competitor links stay available here once the race is launched. -->
            <VerticalStackLayout Spacing="6" Margin="0,16,0,0">
                <Label Text="Competitor links" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="6">
                    <Label Text="{Binding MapLinkText}" FontSize="11" TextColor="Gray" VerticalOptions="Center"
                           LineBreakMode="MiddleTruncation" MaximumWidthRequest="420" />
                    <Button Text="Open live map" FontSize="11" Padding="8,0" HeightRequest="26" IsVisible="{Binding HasMapUrl}"
                            Command="{Binding OpenMapCommand}" />
                    <Button Text="Copy link" FontSize="11" Padding="8,0" HeightRequest="26" IsVisible="{Binding HasMapUrl}"
                            Command="{Binding CopyMapLinkCommand}" />
                </HorizontalStackLayout>

                <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding BoatLinks}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:BoatLinkItem">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="{Binding ParticipantName}" FontSize="13" FontAttributes="Bold" />
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding JoinLinkText}" FontSize="11" TextColor="Gray" VerticalOptions="Center"
                                           LineBreakMode="MiddleTruncation" MaximumWidthRequest="380" />
                                    <Button Text="Copy link" FontSize="11" Padding="8,0" HeightRequest="26"
                                            IsVisible="{Binding HasJoinUrl}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StartSequenceViewModel}}, Path=CopyBoatLinkCommand}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="{Binding LinkMessage}" FontSize="12" TextColor="Gray" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
