<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SailRacing.ViewModels"
             x:Class="SailRacing.Views.Race.StartSequencePage"
             x:DataType="vm:StartSequenceViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">

            <HorizontalStackLayout Spacing="8" HorizontalOptions="Start">
                <Button Text="‹ Races" Command="{Binding BackToRacesCommand}"
                        ToolTipProperties.Text="Back to the race list (the sequence keeps running)" />
                <Button Text="Edit race" Command="{Binding EditRaceCommand}" />
            </HorizontalStackLayout>

            <!-- Pre-sequence feedback: shown before "Begin Start Sequence" is pressed -->
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center"
                                  IsVisible="{Binding IsSequenceStarted, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="{Binding CurrentTimeText}" FontSize="40" HorizontalOptions="Center" />
                <Label Text="{Binding ScheduledCountdownText}" FontSize="16" TextColor="Gray" HorizontalOptions="Center"
                       IsVisible="{Binding HasScheduledStartTime}" />
                <Label Text="No scheduled start time — tap Begin when ready" FontSize="14" TextColor="Gray"
                       HorizontalOptions="Center"
                       IsVisible="{Binding HasScheduledStartTime, Converter={StaticResource InvertedBoolConverter}}" />
            </VerticalStackLayout>

            <!-- Flag stage: flags rest below the counter (row 2) and animate up above it (row 0)
                 when hoisted — see StartSequencePage.xaml.cs. Row heights must match FlagTravelDistance. -->
            <Grid RowDefinitions="100,100,100" HorizontalOptions="Center" WidthRequest="320">

                <Label Grid.Row="1" Text="{Binding CountdownText}" FontSize="64" HorizontalOptions="Center"
                       VerticalOptions="Center" IsVisible="{Binding IsSequenceStarted}" />

                <HorizontalStackLayout Grid.Row="2" Spacing="36" HorizontalOptions="Center" VerticalOptions="Start">

                    <VerticalStackLayout x:Name="ClassFlagCard" HorizontalOptions="Center" Spacing="4">
                        <Grid ColumnDefinitions="6,90" HeightRequest="60" WidthRequest="96">
                            <BoxView Grid.Column="0" Color="#888888" WidthRequest="4" HorizontalOptions="Center" VerticalOptions="Fill" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Start" VerticalOptions="Start" Margin="2,4,0,0">
                                <BoxView Color="White" WidthRequest="20" HeightRequest="34" />
                                <BoxView Color="#1565C0" WidthRequest="20" HeightRequest="34" />
                                <BoxView Color="#C62828" WidthRequest="20" HeightRequest="34" />
                                <BoxView Color="#F9A825" WidthRequest="20" HeightRequest="34" />
                            </HorizontalStackLayout>
                        </Grid>
                        <Label Text="Class flag" FontSize="12" TextColor="Gray" HorizontalOptions="Center"
                               ToolTipProperties.Text="Warning signal — hoisted at 5 minutes before the start" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="PFlagCard" HorizontalOptions="Center" Spacing="4">
                        <Grid ColumnDefinitions="6,60" HeightRequest="60" WidthRequest="66">
                            <BoxView Grid.Column="0" Color="#888888" WidthRequest="4" HorizontalOptions="Center" VerticalOptions="Fill" />
                            <Border Grid.Column="1" BackgroundColor="#1565C0" Stroke="#0d47a1" StrokeThickness="1.5"
                                    HeightRequest="34" WidthRequest="52" HorizontalOptions="Start" VerticalOptions="Start" Margin="2,4,0,0">
                                <BoxView Color="White" WidthRequest="18" HeightRequest="16"
                                         HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <Label Text="Preparatory (P)" FontSize="12" TextColor="Gray" HorizontalOptions="Center"
                               ToolTipProperties.Text="Preparatory signal flag 'P' (Blue Peter) — hoisted at 4 minutes, lowered at 1 minute before the start" />
                    </VerticalStackLayout>

                </HorizontalStackLayout>
            </Grid>

            <Label Text="{Binding StartAtText}" FontSize="18" HorizontalOptions="Center" TextColor="Gray"
                   IsVisible="{Binding IsSequenceStarted}" />

            <Button Text="Begin Start Sequence" Command="{Binding BeginSequenceCommand}"
                    IsVisible="{Binding IsSequenceStarted, Converter={StaticResource InvertedBoolConverter}}" />

            <Label Text="Sequence complete — awaiting All Clear" IsVisible="{Binding IsSequenceComplete}"
                   HorizontalOptions="Center" />

            <Button Text="All Clear — Start Race Mode" Command="{Binding AllClearCommand}"
                    IsVisible="{Binding IsSequenceComplete}" BackgroundColor="Green" TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
