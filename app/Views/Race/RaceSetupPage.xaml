<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SailRacing.ViewModels"
             xmlns:models="clr-namespace:SailRacing.Models"
             x:Class="SailRacing.Views.Race.RaceSetupPage"
             x:DataType="vm:RaceSetupViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="16">

            <Entry Placeholder="Race name" Text="{Binding RaceName}" />

            <Picker Title="Fleet" ItemsSource="{Binding Fleets}" ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedFleet}" />

            <Entry Placeholder="Default laps" Text="{Binding LapsDefaultText}" Keyboard="Numeric" />

            <Label Text="Start line" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="Committee lat" Text="{Binding CommitteeLatitudeText}" />
                <Entry Grid.Column="1" Placeholder="Committee lon" Text="{Binding CommitteeLongitudeText}" />
            </Grid>
            <Button Text="Capture committee boat GPS" Command="{Binding CaptureCommitteeGpsCommand}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="Pin lat" Text="{Binding PinLatitudeText}" />
                <Entry Grid.Column="1" Placeholder="Pin lon" Text="{Binding PinLongitudeText}" />
            </Grid>
            <Button Text="Capture pin GPS" Command="{Binding CapturePinGpsCommand}" />

            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding FinishSameAsStart}" />
                <Label Text="Finish is the same as the start line" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Course marks" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Buoys}" HeightRequest="220">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:BuoyEditItem">
                        <Border Padding="8" Margin="0,0,0,6" Stroke="LightGray" StrokeShape="RoundRectangle 6">
                            <VerticalStackLayout Spacing="4">
                                <Entry Placeholder="Mark name" Text="{Binding Name}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Entry Grid.Column="0" Placeholder="Lat" Text="{Binding LatitudeText}" />
                                    <Entry Grid.Column="1" Placeholder="Lon" Text="{Binding LongitudeText}" />
                                </Grid>
                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="Capture GPS"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RaceSetupViewModel}}, Path=CaptureBuoyGpsCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Remove"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RaceSetupViewModel}}, Path=RemoveBuoyCommand}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Text="+ Add mark" Command="{Binding AddBuoyCommand}" />

            <Label Text="Laps per boat" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding RaceParticipants}" HeightRequest="160">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:RaceParticipantEditItem">
                        <Grid ColumnDefinitions="*,Auto" Padding="4">
                            <Label Grid.Column="0" Text="{Binding ParticipantName}" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding LapsText}" Keyboard="Numeric" WidthRequest="60" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="{Binding StatusMessage}" TextColor="Gray" />

            <HorizontalStackLayout Spacing="8">
                <Button Text="Save" Command="{Binding SaveCommand}" />
                <Button Text="Save &amp; Start Sequence" Command="{Binding StartSequenceCommand}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
