<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SailRacing.ViewModels"
             x:Class="SailRacing.Views.Race.ResultsPage"
             x:DataType="vm:ResultsViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="12" RowSpacing="8">
        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <HorizontalStackLayout Spacing="8">
                <Button Text="‹ Races" Command="{Binding BackToRacesCommand}" ToolTipProperties.Text="Back to the race list" />
                <Button Text="Edit race" Command="{Binding EditRaceCommand}" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="6">
                <Label Text="{Binding ReplayLinkText}" FontSize="11" TextColor="Gray" VerticalOptions="Center"
                       LineBreakMode="MiddleTruncation" MaximumWidthRequest="420" />
                <Button Text="Open replay" FontSize="11" Padding="8,0" HeightRequest="26" IsVisible="{Binding HasReplayUrl}"
                        ToolTipProperties.Text="Replay the race from its recorded GPS traces"
                        Command="{Binding OpenReplayCommand}" />
                <Button Text="Copy link" FontSize="11" Padding="8,0" HeightRequest="26" IsVisible="{Binding HasReplayUrl}"
                        Command="{Binding CopyReplayLinkCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="2">
            <Grid Grid.Row="0" ColumnDefinitions="40,*,70,90,90,120,120" Padding="8,0" ColumnSpacing="6">
                <Label Grid.Column="0" Text="Rank" FontSize="12" TextColor="Gray" />
                <Label Grid.Column="1" Text="Boat" FontSize="12" TextColor="Gray" />
                <Label Grid.Column="2" Text="TCF" FontSize="12" TextColor="Gray"
                       ToolTipProperties.Text="Time Correction Factor — the boat's handicap" />
                <Label Grid.Column="3" Text="Status" FontSize="12" TextColor="Gray"
                       ToolTipProperties.Text="Finished, DNF (Did Not Finish), DNS (Did Not Start), RET (Retired), or OCS (On Course Side / premature start)" />
                <Label Grid.Column="4" Text="Finish" FontSize="12" TextColor="Gray"
                       ToolTipProperties.Text="Clock time the boat finished" />
                <Label Grid.Column="5" Text="Real time" FontSize="12" TextColor="Gray"
                       ToolTipProperties.Text="Elapsed time from the start signal to the finish, h:mm:ss" />
                <Label Grid.Column="6" Text="Corrected (TCF)" FontSize="12" TextColor="Gray"
                       ToolTipProperties.Text="Real time x TCF — this decides the ranking" />
            </Grid>

            <CollectionView Grid.Row="1" ItemsSource="{Binding Results}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ResultsEntry">
                        <Grid ColumnDefinitions="40,*,70,90,90,120,120" Padding="8" ColumnSpacing="6">
                            <Label Grid.Column="0" Text="{Binding RankText}" FontAttributes="Bold" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding ParticipantName}" />
                                <Label Text="{Binding Helm}" FontSize="11" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding TcfText}" />
                            <Label Grid.Column="3" Text="{Binding Status}" />
                            <Label Grid.Column="4" Text="{Binding FinishClockText}" />
                            <Label Grid.Column="5" Text="{Binding ElapsedText}" />
                            <Label Grid.Column="6" Text="{Binding CorrectedText}" FontAttributes="Bold" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Label Grid.Row="2" Text="{Binding StatusMessage}" TextColor="Gray" />
        <HorizontalStackLayout Grid.Row="3" Spacing="8">
            <Button Text="Publish Results" Command="{Binding PublishCommand}" />
            <Button Text="Export (CSV)" Command="{Binding ExportCommand}"
                    ToolTipProperties.Text="Save the results as a spreadsheet-ready CSV file (Documents\Sail-Racing results)" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
