<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SailRacing.ViewModels"
             x:Class="SailRacing.Views.Race.ResultsPage"
             x:DataType="vm:ResultsViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="12" RowSpacing="8">
        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <HorizontalStackLayout Spacing="8">
                <Button Text="‹ Races" Command="{Binding BackToRacesCommand}" ToolTipProperties.Text="Back to the race list" />
                <Button Text="Edit race" Command="{Binding EditRaceCommand}" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="6">
                <Label Text="{Binding ReplayLinkText}" FontSize="11" TextColor="Gray" VerticalOptions="Center"
                       LineBreakMode="MiddleTruncation" MaximumWidthRequest="420" />
                <Button Text="Open replay" FontSize="11" Padding="8,0" HeightRequest="26" IsVisible="{Binding HasReplayUrl}"
                        ToolTipProperties.Text="Replay the race from its recorded GPS traces"
                        Command="{Binding OpenReplayCommand}" />
                <Button Text="Copy link" FontSize="11" Padding="8,0" HeightRequest="26" IsVisible="{Binding HasReplayUrl}"
                        Command="{Binding CopyReplayLinkCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Results}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ResultsEntry">
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="8">
                        <Label Grid.Column="0" Text="{Binding Rank}" FontAttributes="Bold" WidthRequest="32" />
                        <Label Grid.Column="1" Text="{Binding ParticipantName}" />
                        <Label Grid.Column="2" Text="{Binding Status}"
                               ToolTipProperties.Text="Finished, DNF (Did Not Finish), DNS (Did Not Start), RET (Retired), or OCS (On Course Side / premature start)" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="2" Text="{Binding StatusMessage}" TextColor="Gray" />
        <Button Grid.Row="3" Text="Publish Results" Command="{Binding PublishCommand}" />
    </Grid>
</ContentPage>
