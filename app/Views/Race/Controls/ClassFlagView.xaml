<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SailRacing.Views.Race.Controls.ClassFlagView">

    <!-- The class flag: white, blue, red and yellow panels on a pole. -->
    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
        <Grid ColumnDefinitions="6,90" HeightRequest="60" WidthRequest="96">
            <BoxView Grid.Column="0" Color="#888888" WidthRequest="4" HorizontalOptions="Center" VerticalOptions="Fill" />
            <HorizontalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Start" VerticalOptions="Start" Margin="2,4,0,0">
                <BoxView Color="White" WidthRequest="20" HeightRequest="34" />
                <BoxView Color="#1565C0" WidthRequest="20" HeightRequest="34" />
                <BoxView Color="#C62828" WidthRequest="20" HeightRequest="34" />
                <BoxView Color="#F9A825" WidthRequest="20" HeightRequest="34" />
            </HorizontalStackLayout>
        </Grid>
        <Label Text="Class flag" FontSize="12" TextColor="Gray" HorizontalOptions="Center"
               ToolTipProperties.Text="Warning signal — hoisted at the first signal time (Settings → Start sequence; 5 minutes before the start by default)" />
    </VerticalStackLayout>
</ContentView>
