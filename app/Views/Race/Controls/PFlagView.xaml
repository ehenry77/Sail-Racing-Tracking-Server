<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SailRacing.Views.Race.Controls.PFlagView">

    <!-- The preparatory flag "P" (Blue Peter): blue with a white square. -->
    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
        <Grid ColumnDefinitions="6,60" HeightRequest="60" WidthRequest="66">
            <BoxView Grid.Column="0" Color="#888888" WidthRequest="4" HorizontalOptions="Center" VerticalOptions="Fill" />
            <Border Grid.Column="1" BackgroundColor="#1565C0" Stroke="#0d47a1" StrokeThickness="1.5"
                    HeightRequest="34" WidthRequest="52" HorizontalOptions="Start" VerticalOptions="Start" Margin="2,4,0,0">
                <BoxView Color="White" WidthRequest="18" HeightRequest="16"
                         HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>
        <Label Text="Preparatory (P)" FontSize="12" TextColor="Gray" HorizontalOptions="Center"
               ToolTipProperties.Text="Preparatory signal flag 'P' (Blue Peter) — hoisted and lowered at the times set in Settings → Start sequence (4 minutes and 1 minute before the start by default)" />
    </VerticalStackLayout>
</ContentView>
