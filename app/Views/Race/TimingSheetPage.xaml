<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SailRacing.ViewModels"
             x:Class="SailRacing.Views.Race.TimingSheetPage"
             x:DataType="vm:TimingSheetViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="12" RowSpacing="8">
        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Button Text="‹ Races" Command="{Binding BackToRacesCommand}" ToolTipProperties.Text="Back to the race list" />
            <Button Text="Edit race" Command="{Binding EditRaceCommand}" />
        </HorizontalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="4">
            <HorizontalStackLayout Spacing="6">
                <Label Text="{Binding MapLinkText}" FontSize="11" TextColor="Gray" VerticalOptions="Center"
                       LineBreakMode="MiddleTruncation" MaximumWidthRequest="420" />
                <Button Text="Open live map" FontSize="11" Padding="8,0" HeightRequest="26" IsVisible="{Binding HasMapUrl}"
                        ToolTipProperties.Text="Open the live map of all boats in your browser"
                        Command="{Binding OpenMapCommand}" />
                <Button Text="Copy link" FontSize="11" Padding="8,0" HeightRequest="26" IsVisible="{Binding HasMapUrl}"
                        Command="{Binding CopyMapLinkCommand}" />
            </HorizontalStackLayout>
            <Label Text="{Binding ConnectionStatusText}" TextColor="OrangeRed" FontSize="12"
                   IsVisible="{Binding HasConnectionIssue}" />
            <Label Text="{Binding InfoMessage}" TextColor="Gray" FontSize="12" />
        </VerticalStackLayout>

        <!-- Manual lap/finish-time entry: the offline-capable fallback to the server's GPS-based
             auto lap-counting, for when a competitor isn't tracking or the server is unreachable. -->
        <Border Grid.Row="2" Padding="10" Stroke="Gray" StrokeShape="RoundRectangle 8"
                IsVisible="{Binding SelectedEntry, Converter={StaticResource NotNullConverter}}">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding SelectedEntry.ParticipantName}" FontAttributes="Bold" />
                <Label FontSize="12" TextColor="Gray">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding SelectedEntry.LapsCompleted}" />
                            <Span Text="/" />
                            <Span Text="{Binding SelectedEntry.Laps}" />
                            <Span Text=" laps completed" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Button Text="Record Lap Now" ToolTipProperties.Text="Stamps the current time as this boat's next lap"
                        Command="{Binding RecordLapNowCommand}" CommandParameter="{Binding SelectedEntry}" />

                <Label Text="Finish time" FontSize="12" TextColor="Gray" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <DatePicker Grid.Column="0" Date="{Binding EditFinishDate}" />
                    <TimePicker Grid.Column="1" Time="{Binding EditFinishTimeOfDay}" />
                </Grid>

                <HorizontalStackLayout Spacing="8">
                    <Button Text="Set Finish Time" Command="{Binding SetFinishTimeCommand}"
                            CommandParameter="{Binding SelectedEntry}" />
                    <Button Text="Close" Command="{Binding ClearSelectionCommand}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="3" ItemsSource="{Binding Entries}"
                         SelectionMode="Single" SelectedItem="{Binding SelectedEntry}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:RaceTimingEntry">
                    <Border Padding="8" Margin="0,0,0,6" Stroke="LightGray" StrokeShape="RoundRectangle 6"
                            ToolTipProperties.Text="Tap to record a lap or set this boat's finish time manually">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding ParticipantName}" FontAttributes="Bold" />
                                <Label FontSize="12">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding LapsCompleted}" />
                                            <Span Text="/" />
                                            <Span Text="{Binding Laps}" />
                                            <Span Text=" laps — " />
                                            <Span Text="{Binding Status}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding JoinLinkText}" FontSize="11" TextColor="Gray" VerticalOptions="Center"
                                           LineBreakMode="MiddleTruncation" MaximumWidthRequest="380"
                                           ToolTipProperties.Text="{Binding JoinLinkText}" />
                                    <Button Text="Copy link" FontSize="11" Padding="8,0" HeightRequest="26"
                                            IsVisible="{Binding HasJoinUrl}"
                                            ToolTipProperties.Text="Copy this boat's personal tracking link, to send to its skipper"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TimingSheetViewModel}}, Path=CopyJoinLinkCommand}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="FINAL LAP" TextColor="OrangeRed" FontAttributes="Bold"
                                   VerticalOptions="Center" IsVisible="{Binding IsOnFinalLap}" />
                            <Button Grid.Column="2" Text="DNF" ToolTipProperties.Text="Did Not Finish"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TimingSheetViewModel}}, Path=SetDnfCommand}"
                                    CommandParameter="{Binding .}" />
                            <Button Grid.Column="3" Text="DNS" ToolTipProperties.Text="Did Not Start"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TimingSheetViewModel}}, Path=SetDnsCommand}"
                                    CommandParameter="{Binding .}" />
                            <Button Grid.Column="4" Text="RET" ToolTipProperties.Text="Retired"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TimingSheetViewModel}}, Path=SetRetCommand}"
                                    CommandParameter="{Binding .}" />
                            <Button Grid.Column="5" Text="OCS" ToolTipProperties.Text="On Course Side (premature start)"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TimingSheetViewModel}}, Path=SetOcsCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="4" Spacing="8">
            <Button Text="Shorten Course" Command="{Binding ShortenCourseCommand}" />
            <Button Text="View Results" Command="{Binding ViewResultsCommand}" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
